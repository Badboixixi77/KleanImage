# ── Next.js ──────────────────────────────────────────────────────────────────
# The production URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://kleanimage.com.ng

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # Safe to expose — used in browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # SECRET — server only, NEVER prefix with NEXT_PUBLIC_

# ── Sanity CMS ────────────────────────────────────────────────────────────────
# Found in: manage.sanity.io → your project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=sk...                        # SECRET — server only (read/write token)
SANITY_REVALIDATE_SECRET=a-long-random-string # SECRET — used to verify CMS webhook calls

# ── Resend (email) ────────────────────────────────────────────────────────────
# Sign up at resend.com — verify your sending domain first
RESEND_API_KEY=re_...                         # SECRET — server only
RESEND_FROM_EMAIL=quotes@kleanimage.com.ng    # Must match a verified Resend domain
OWNER_EMAIL=owner@example.com                 # TODO: owner to provide — receives quote notifications

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
# dashboard.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...          # Safe to expose
TURNSTILE_SECRET_KEY=0x...                    # SECRET — server only

# ── Sentry ────────────────────────────────────────────────────────────────────
# sentry.io → your project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=...                         # SECRET — CI only, for source map uploads

# ── Plausible Analytics ───────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=kleanimage.com.ng

# ── Google Maps ───────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
# TODO: owner to claim Google Business Profile first
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" when Phase 2 (Paystack payments) is ready to go live
NEXT_PUBLIC_FEATURE_PAYSTACK=false
